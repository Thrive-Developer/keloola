{
  "name": "n8n-nodes-keloola-workspace",
  "version": "0.2.0",
  "description": "n8n community node package for Keloola Workspace",
  "license": "MIT",
  "homepage": "https://github.com/Thrive-Developer/keloola/tree/main/n8n-nodes-keloola-workspace#readme",
  "keywords": [
    "n8n-community-node-package",
    "keloola",
    "workspace",
    "api",
    "n8n"
  ],
  "author": {
    "name": "Benny Rahmat",
    "email": "akunbeben@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Thrive-Developer/keloola.git",
    "directory": "n8n-nodes-keloola-workspace"
  },
  "scripts": {
    "build": "bunx --bun n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "bun x --bun n8n-node dev",
    "lint": "bun x --bun n8n-node lint",
    "lint:fix": "bun x --bun n8n-node lint --fix",
    "format": "prettier --write \"**/*.ts\" --ignore-path ../.prettierignore",
    "format:check": "prettier --check \"**/*.ts\" --ignore-path ../.prettierignore",
    "check-types": "tsc --noEmit",
    "release": "bun x --bun n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/KeloolaWorkspaceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Workspace/KeloolaWorkspace.node.js"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@repo/support": "workspace:*",
    "@n8n/node-cli": "*",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
